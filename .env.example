APP_NAME="Ads of Iraq"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Baghdad
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ads_of_iraq
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=resend
RESEND_KEY=
MAIL_FROM_ADDRESS="verify@adsofiraq.com"
MAIL_FROM_NAME="Ads of Iraq"
# Optional: dedicated log channel for mail failures (defaults to stack)
# MAIL_LOG_CHANNEL=stack

# Upload limits (KB)
UPLOAD_MAX_THUMBNAIL=2048
UPLOAD_MAX_ASSET=5120
UPLOAD_MAX_VIDEO=51200
UPLOAD_MAX_VIDEOS=5
FFMPEG_PATH=ffmpeg

# Campaign URL importer
IMPORT_HTTP_TIMEOUT=30
IMPORT_COUNTRY_PAGE_TIMEOUT=15
IMPORT_COUNTRY_PAGE_RETRIES=3
BULK_IMPORT_CONVERT_VIDEOS=false
BULK_IMPORT_PROCESS_DELAY_MS=3000
BULK_IMPORT_PROCESS_DELAY_MAX_MS=5000
IMPORT_BULK_PROCESS_TIMEOUT=120
IMPORT_BULK_STUCK_ITEM_MINUTES=3
NEW_IMPORT_STOP_AFTER_EXISTING=20
IMPORT_MAX_IMAGE_MB=10
IMPORT_MAX_VIDEO_MB=200
IMPORT_IMAGE_MAX_WIDTH=2560
IMPORT_WEBP_QUALITY=82
IMPORT_FFMPEG_TIMEOUT=120
IMPORT_VIDEO_WEBM_CRF=32

VITE_APP_NAME="${APP_NAME}"
